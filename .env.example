# Lumenist Configuration

# Admin Passphrase for /admin/upload
ADMIN_PASSWORD=lumenist-admin

# Secret key used for signing session tokens (optional, generated from password if unset)
ADMIN_SECRET=change-me-to-a-secure-random-string

# Optional: Path to photos directory on the server (defaults to public/photos symlink)
# PHOTOS_DIR=/var/www/photos

# Optional: Path to external or local photo source directory
# LOCAL_PHOTO_DIR=/path/to/photos
# PHOTOS_SOURCE_DIR=/path/to/photos/source
